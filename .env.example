# Copy to .env. The application explicitly imports this file; never commit .env.
# Docker Compose also reads these variables. Use unquoted values without spaces.
DB_PORT=3306
DB_URL=jdbc:mariadb://127.0.0.1:3306/lms?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=lms
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Required: generate a random value of at least 32 bytes.
JWT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
SERVER_PORT=8080
STORAGE_DIRECTORY=./.storage
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Existing server-only Discord webhook; do not commit its value.
DISCORD_WEBHOOK_URL=
# HTTPS origin serving the community owner's public notice page.
DISCORD_PUBLIC_BASE_URL=
